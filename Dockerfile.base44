# Base44 dev runtime: Node (frontend/Vite + npm) + Deno (local Base44 backend).
# Source is bind-mounted at /app — nothing is baked into the image, so edits
# hot-reload without a rebuild.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl unzip ca-certificates git \
    && curl -fsSL https://deno.land/install.sh | DENO_DIR=/root/.deno sh \
    && ln -s /root/.deno/bin/deno /usr/local/bin/deno \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Base44 CLI — used to run `base44 dev` (local backend + frontend orchestrator).
RUN npm install -g base44@latest

WORKDIR /app
